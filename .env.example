# Local Postgres (Homebrew): postgresql://<your-macos-user>@localhost:5432/portfolio?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"

# NextAuth v5 — AUTH_SECRET signs sessions
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST=true

# Only this email may sign in
ADMIN_EMAIL="you@example.com"

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_ID=""
GITHUB_SECRET=""
